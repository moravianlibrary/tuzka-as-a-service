{
  "version": "0.1.0",
  "name": "taas",
  "tiles": [
    {
      "id": "taas-1",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 10,
      "config": {
        "granularity": "auto",
        "alignDateRangeToGranularity": true,
        "where": "event:done",
        "whereLanguage": "lucene",
        "name": "Pages done per domain",
        "source": "Job Events",
        "displayType": "stacked_bar",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "sql",
            "valueExpression": ""
          }
        ],
        "groupBy": "domain"
      }
    },
    {
      "id": "taas-2",
      "x": 12,
      "y": 0,
      "w": 12,
      "h": 10,
      "config": {
        "granularity": "auto",
        "alignDateRangeToGranularity": true,
        "where": "event:done",
        "whereLanguage": "lucene",
        "name": "Total time p50 / p95 per domain (s)",
        "source": "Job Events",
        "displayType": "line",
        "numberFormat": {
          "output": "number",
          "mantissa": 2,
          "thousandSeparated": true,
          "average": false,
          "decimalBytes": false,
          "factor": 1
        },
        "select": [
          {
            "aggFn": "quantile",
            "aggCondition": "",
            "aggConditionLanguage": "sql",
            "valueExpression": "total_s",
            "level": 0.5
          },
          {
            "aggFn": "quantile",
            "aggCondition": "",
            "aggConditionLanguage": "sql",
            "valueExpression": "total_s",
            "level": 0.95
          }
        ],
        "groupBy": "domain"
      }
    },
    {
      "id": "taas-3",
      "x": 0,
      "y": 10,
      "w": 12,
      "h": 10,
      "config": {
        "granularity": "auto",
        "alignDateRangeToGranularity": true,
        "where": "event:failed",
        "whereLanguage": "lucene",
        "name": "Failures by error class",
        "source": "Job Events",
        "displayType": "stacked_bar",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "sql",
            "valueExpression": ""
          }
        ],
        "groupBy": "error_class"
      }
    },
    {
      "id": "taas-4",
      "x": 12,
      "y": 10,
      "w": 12,
      "h": 10,
      "config": {
        "granularity": "auto",
        "alignDateRangeToGranularity": true,
        "where": "event:done",
        "whereLanguage": "lucene",
        "name": "Engine run time per backend (s, avg)",
        "source": "Job Events",
        "displayType": "line",
        "numberFormat": {
          "output": "number",
          "mantissa": 2,
          "thousandSeparated": true,
          "average": false,
          "decimalBytes": false,
          "factor": 1
        },
        "select": [
          {
            "aggFn": "avg",
            "aggCondition": "",
            "aggConditionLanguage": "sql",
            "valueExpression": "run_s"
          }
        ],
        "groupBy": "backend_id"
      }
    },
    {
      "id": "taas-5",
      "x": 0,
      "y": 20,
      "w": 24,
      "h": 8,
      "config": {
        "granularity": "auto",
        "alignDateRangeToGranularity": true,
        "where": "metric:queued",
        "whereLanguage": "lucene",
        "name": "Queue depth",
        "source": "Live Metrics",
        "displayType": "line",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true,
          "average": false,
          "decimalBytes": false,
          "factor": 1
        },
        "select": [
          {
            "aggFn": "max",
            "aggCondition": "",
            "aggConditionLanguage": "sql",
            "valueExpression": "value"
          }
        ],
        "groupBy": ""
      }
    },
    {
      "id": "taas-maps-georef",
      "x": 0,
      "y": 28,
      "w": 12,
      "h": 8,
      "config": {
        "granularity": "auto",
        "alignDateRangeToGranularity": true,
        "whereLanguage": "lucene",
        "source": "Job Events",
        "numberFormat": {
          "output": "number",
          "mantissa": 2,
          "thousandSeparated": true,
          "average": false,
          "decimalBytes": false,
          "factor": 1
        },
        "where": "event:done AND domain:maps",
        "name": "Maps: georef status share",
        "displayType": "stacked_bar",
        "select": [
          {
            "aggFn": "count",
            "aggCondition": "",
            "aggConditionLanguage": "sql",
            "valueExpression": ""
          }
        ],
        "groupBy": "extra['georef.status']"
      }
    },
    {
      "id": "taas-maps-residual",
      "x": 12,
      "y": 28,
      "w": 12,
      "h": 8,
      "config": {
        "granularity": "auto",
        "alignDateRangeToGranularity": true,
        "whereLanguage": "lucene",
        "source": "Job Events",
        "numberFormat": {
          "output": "number",
          "mantissa": 2,
          "thousandSeparated": true,
          "average": false,
          "decimalBytes": false,
          "factor": 1
        },
        "where": "event:done AND domain:maps",
        "name": "Maps: median georef residual (m)",
        "displayType": "line",
        "select": [
          {
            "aggFn": "quantile",
            "level": 0.5,
            "aggCondition": "",
            "aggConditionLanguage": "sql",
            "valueExpression": "toFloat64OrNull(extra['georef.residual_m'])"
          }
        ],
        "groupBy": ""
      }
    }
  ],
  "filters": [],
  "containers": []
}
