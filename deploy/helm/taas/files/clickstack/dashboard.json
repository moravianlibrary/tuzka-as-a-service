{
  "name": "taas",
  "tags": [
    "taas"
  ],
  "tiles": [
    {
      "name": "Pages done per domain",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 10,
      "config": {
        "displayType": "stacked_bar",
        "sourceId": "Job Events",
        "select": [
          {
            "aggFn": "count",
            "where": "event = 'done'",
            "whereLanguage": "sql"
          }
        ],
        "groupBy": "domain"
      }
    },
    {
      "name": "Total time p50 / p95 per domain (s)",
      "x": 12,
      "y": 0,
      "w": 12,
      "h": 10,
      "config": {
        "displayType": "line",
        "sourceId": "Job Events",
        "select": [
          {
            "aggFn": "quantile",
            "valueExpression": "total_s",
            "level": 0.5,
            "alias": "p50",
            "where": "event = 'done'",
            "whereLanguage": "sql"
          },
          {
            "aggFn": "quantile",
            "valueExpression": "total_s",
            "level": 0.95,
            "alias": "p95",
            "where": "event = 'done'",
            "whereLanguage": "sql"
          }
        ],
        "groupBy": "domain",
        "numberFormat": {
          "output": "number",
          "mantissa": 2,
          "thousandSeparated": true,
          "average": false,
          "decimalBytes": false,
          "factor": 1
        },
        "alignDateRangeToGranularity": true
      }
    },
    {
      "name": "Failures by error class",
      "x": 0,
      "y": 10,
      "w": 12,
      "h": 10,
      "config": {
        "displayType": "stacked_bar",
        "sourceId": "Job Events",
        "select": [
          {
            "aggFn": "count",
            "where": "event = 'failed'",
            "whereLanguage": "sql"
          }
        ],
        "groupBy": "error_class"
      }
    },
    {
      "name": "Engine run time per backend (s, avg)",
      "x": 12,
      "y": 10,
      "w": 12,
      "h": 10,
      "config": {
        "displayType": "line",
        "sourceId": "Job Events",
        "select": [
          {
            "aggFn": "avg",
            "valueExpression": "run_s",
            "where": "event = 'done'",
            "whereLanguage": "sql"
          }
        ],
        "groupBy": "if(backend = '', toString(backend_id), backend)",
        "numberFormat": {
          "output": "number",
          "mantissa": 2,
          "thousandSeparated": true,
          "average": false,
          "decimalBytes": false,
          "factor": 1
        },
        "alignDateRangeToGranularity": true
      }
    },
    {
      "name": "Queue depth",
      "x": 0,
      "y": 20,
      "w": 12,
      "h": 8,
      "config": {
        "displayType": "line",
        "sourceId": "Live Metrics",
        "select": [
          {
            "aggFn": "max",
            "valueExpression": "value",
            "where": "metric = 'queued'",
            "whereLanguage": "sql"
          }
        ],
        "groupBy": "labels['domain']",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true,
          "average": false,
          "decimalBytes": false,
          "factor": 1
        },
        "alignDateRangeToGranularity": true
      }
    },
    {
      "name": "Backend in-flight",
      "x": 12,
      "y": 20,
      "w": 12,
      "h": 8,
      "config": {
        "displayType": "line",
        "sourceId": "Live Metrics",
        "alignDateRangeToGranularity": true,
        "select": [
          {
            "aggFn": "max",
            "valueExpression": "value",
            "where": "metric = 'backend_inflight'",
            "whereLanguage": "sql"
          }
        ],
        "groupBy": "labels['backend']"
      }
    },
    {
      "name": "Maps: georef status share",
      "x": 0,
      "y": 28,
      "w": 12,
      "h": 8,
      "config": {
        "displayType": "stacked_bar",
        "sourceId": "Job Events",
        "select": [
          {
            "aggFn": "count",
            "where": "event = 'done' AND domain = 'maps'",
            "whereLanguage": "sql"
          }
        ],
        "groupBy": "extra['georef.status']",
        "numberFormat": {
          "output": "number",
          "mantissa": 2,
          "thousandSeparated": true,
          "average": false,
          "decimalBytes": false,
          "factor": 1
        }
      }
    },
    {
      "name": "Maps: median georef residual (m)",
      "x": 12,
      "y": 28,
      "w": 12,
      "h": 8,
      "config": {
        "displayType": "line",
        "sourceId": "Job Events",
        "select": [
          {
            "aggFn": "quantile",
            "valueExpression": "toFloat64OrNull(extra['georef.residual_m'])",
            "level": 0.5,
            "alias": "p50",
            "where": "event = 'done' AND domain = 'maps'",
            "whereLanguage": "sql"
          }
        ],
        "numberFormat": {
          "output": "number",
          "mantissa": 2,
          "thousandSeparated": true,
          "average": false,
          "decimalBytes": false,
          "factor": 1
        },
        "alignDateRangeToGranularity": true
      }
    },
    {
      "name": "Pages done per user",
      "x": 0,
      "y": 36,
      "w": 12,
      "h": 8,
      "config": {
        "displayType": "stacked_bar",
        "sourceId": "Job Events",
        "select": [
          {
            "aggFn": "count",
            "where": "event = 'done'",
            "whereLanguage": "sql"
          }
        ],
        "groupBy": "username"
      }
    },
    {
      "name": "Failures per user",
      "x": 12,
      "y": 36,
      "w": 12,
      "h": 8,
      "config": {
        "displayType": "stacked_bar",
        "sourceId": "Job Events",
        "select": [
          {
            "aggFn": "count",
            "where": "event = 'failed'",
            "whereLanguage": "sql"
          }
        ],
        "groupBy": "username"
      }
    },
    {
      "name": "Total time p50 / p95 per user (s)",
      "x": 0,
      "y": 44,
      "w": 24,
      "h": 8,
      "config": {
        "displayType": "line",
        "sourceId": "Job Events",
        "select": [
          {
            "aggFn": "quantile",
            "valueExpression": "total_s",
            "level": 0.5,
            "alias": "p50",
            "where": "event = 'done'",
            "whereLanguage": "sql"
          },
          {
            "aggFn": "quantile",
            "valueExpression": "total_s",
            "level": 0.95,
            "alias": "p95",
            "where": "event = 'done'",
            "whereLanguage": "sql"
          }
        ],
        "groupBy": "username",
        "numberFormat": {
          "output": "number",
          "mantissa": 2,
          "thousandSeparated": true,
          "average": false,
          "decimalBytes": false,
          "factor": 1
        },
        "alignDateRangeToGranularity": true
      }
    }
  ]
}
