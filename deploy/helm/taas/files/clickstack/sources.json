[
  {
    "name": "Job Events",
    "kind": "log",
    "connection": "taas ClickHouse",
    "from": { "databaseName": "taas", "tableName": "job_events" },
    "timestampValueExpression": "ts",
    "displayedTimestampValueExpression": "ts",
    "implicitColumnExpression": "event",
    "bodyExpression": "event",
    "serviceNameExpression": "domain",
    "severityTextExpression": "if(error_flag = 1, 'error', 'info')",
    "eventAttributesExpression": "extra",
    "defaultTableSelectExpression": "ts,event,job_id,username,domain,backend_id,device,error_class,total_s"
  },
