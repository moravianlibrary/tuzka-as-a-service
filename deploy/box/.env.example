# Copy to `.env` and fill in. Used by compose.yaml + frpc.toml.

# --- Tunnel (frpc -> in-cluster frps) ---
# A cluster node IP reachable from this box, and the frps NodePort (tunnel.service.nodePort).
FRP_SERVER_ADDR=10.0.0.10
FRP_SERVER_PORT=32700
# Must equal the cluster's Helm value secrets.frpToken.
FRP_TOKEN=replaceMe

# --- This box / engine identity ---
# BOX_NAME prefixes the exporter proxy names (keep unique per box). ENGINE_NAME is the
# frpc proxy name for the engine. REMOTE_PORT MUST equal this engine's
# tunnelBoxes[].engines[].remotePort in the Helm values, and be unique across all boxes.
BOX_NAME=box1
ENGINE_NAME=gpu1
REMOTE_PORT=8000

# --- Exporters (optional; single-engine compose.yaml) ---
# Tunnel this box's cAdvisor / GPU exporter to the cluster Prometheus. Leave unset to
# skip (the frpc.toml blocks drop out). Each MUST equal this box's
# tunnelBoxes[].exporters[].remotePort and be unique across all boxes.
# FRP_CADVISOR_REMOTE_PORT=8010
# FRP_GPU_EXPORTER_REMOTE_PORT=8011

# --- OCR engine ---
# Must equal the cluster's Helm value secrets.ocrEngineApiKey.
OCR_API_KEY=replaceMe
# cpu (default) or cuda. For cuda you MUST also add the GPU overlay on `up`
# (see README) and use a CUDA image/Dockerfile.gpu.
OCR_DEVICE=cpu

# --- Up-hours (optional) ---
# When the box may run OCR. Default "always" — the scheduler + gate stay inert and the
# box behaves exactly as before. Entries are "<days> <HH:MM>-<HH:MM>", separated by ";"
# (or by a comma after a time range); day lists/ranges wrap ("Fri-Mon", "Sat,Sun"), and
# a window whose end is <= its start runs past midnight into the next day.
#   OCR_UP_SCHEDULE="Mon-Fri 17:30-07:30; Sat,Sun 00:00-24:00"   # off-hours + weekends
#   OCR_UP_SCHEDULE="never"                                       # parked
# TZ is the timezone the schedule is written in — set it, or the box schedules in UTC.
TZ=Europe/Prague
OCR_UP_SCHEDULE=always
# Minutes between closing the gate (taas stops dispatching within ~10s) and stopping the
# engine. In-flight pages finish and are harvested during this window; anything still
# unfinished when it expires is requeued by the cluster.
OCR_DRAIN_MINUTES=10
# 1 = also stop frpc after the engine (default 0: the tunnel stays up so the box's
# cAdvisor/GPU metrics keep reaching the cluster while the engine is parked).
OCR_STOP_TUNNEL=0
# Bypass the gate entirely (tunnel -> engine directly). Disables up-hours scheduling.
# FRP_LOCAL_IP=tuzkaocr

# Run mode: "registry" (pull OCR_IMAGE) or "build" (build from ./TuzkaOCR).
COMPOSE_PROFILES=registry
# registry mode — override for a different / GPU-specific image tag. TuzkaOCR v1.7.0 is
# verified compatible with this box (no compose/env changes needed beyond the tag).
# OCR_IMAGE=registry.gitlab.mzk.cz/osdd/image/tuzka-as-a-service/tuzkaocr:1.7.0
# build mode — local checkout to build from (Dockerfile = CPU, Dockerfile.gpu = GPU).
# OCR_BUILD_CONTEXT=./TuzkaOCR
# OCR_DOCKERFILE=Dockerfile
